{
  "expo": {
    "name": "Localify",
    "slug": "localify-mobile",
    "scheme": "localify",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.localify.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.localify.mobile"
    },
    "plugins": ["expo-router", "expo-av"]
  }
}
